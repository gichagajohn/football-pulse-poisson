# football-data.org free token  →  https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# The Odds API free key         →  https://the-odds-api.com/
ODDS_API_KEY=

# OpenWeatherMap (forecast)     →  https://openweathermap.org/api
OPENWEATHER_KEY=

# Supabase project URL + service_role key (never the anon key)
SUPABASE_URL=
SUPABASE_KEY=

# Gmail: use an App Password, not your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=

# Optional overrides
# LEAGUE_IDS=PL,PD
# MAX_SELECTIONS=3
# MIN_WEIGHTED_GAMES=6

# ── Odds API spend control (free plan = 500 credits/month) ──────────────────
# One credit = one market x one region. h2h+totals on 6 leagues = 12/day.
# Turning BTTS on adds 3 per league per day (~540/month) which EXCEEDS the
# free plan, so it is off by default.
# ODDS_FETCH_BTTS=0
# ODDS_REGIONS=eu
# ODDS_MIN_CREDITS_REMAINING=25

# ── Model vs market ─────────────────────────────────────────────────────────
# Gates use  w * model_p + (1 - w) * devigged_market_p.  1.0 = old behaviour.
# MODEL_WEIGHT=0.60
# TWO_WAY_OVERROUND=1.04

# ── Fixture matching / ticket hygiene ──────────────────────────────────────
# FIXTURE_MATCH_TOLERANCE_MINUTES=30
# TICKET_MAX_PENDING_DAYS=3

# NOTE: previous-season history is NOT available on the football-data.org
# free tier (current season only), so early-season ratings are thin and the
# bot deliberately stays quiet until teams clear MIN_WEIGHTED_GAMES.
